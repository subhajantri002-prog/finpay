# SQLite connection string for local demo use
DATABASE_URL=sqlite:///./finpay.db

# JWT settings
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS settings
CORS_ORIGIN=http://localhost:5173

# Demo mode for student top-up testing
DEMO_MODE=true

# Optional Cashback rule from environment (percentage, e.g., 2.5 for 2.5%, 0 for none)
CASHBACK_PERCENTAGE=0
CASHBACK_MIN_AMOUNT=0
